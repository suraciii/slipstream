{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Slipstream Film measurement syntax",
  "description": "Normative closed syntax. Parser and semantic checks in processing-film-measurement.md remain required.",
  "$defs": {
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "Id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$",
      "minLength": 32,
      "maxLength": 32
    },
    "U64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "Image": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._:/-]*@)?sha256:[0-9a-f]{64}$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "AbsolutePath": {
      "type": "string",
      "minLength": 2,
      "maxLength": 4096,
      "pattern": "^/[^\\u0000\\uD800-\\uDFFF]*$"
    },
    "Config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "mode",
        "instance",
        "root",
        "socket",
        "peer_uid",
        "image",
        "memory_bytes",
        "receipt_retention_seconds",
        "catalogue_sha256",
        "resource_model_sha256"
      ],
      "properties": {
        "version": {
          "const": 2
        },
        "mode": {
          "const": "film-measurement"
        },
        "instance": {
          "$ref": "#/$defs/Id"
        },
        "root": {
          "$ref": "#/$defs/AbsolutePath"
        },
        "socket": {
          "$ref": "#/$defs/AbsolutePath"
        },
        "peer_uid": {
          "const": 0
        },
        "image": {
          "$ref": "#/$defs/Image"
        },
        "memory_bytes": {
          "enum": [
            8589934592, 12884901888, 17179869184, 25769803776, 34359738368
          ]
        },
        "receipt_retention_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604800
        },
        "catalogue_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "resource_model_sha256": {
          "$ref": "#/$defs/Sha256"
        }
      }
    },
    "Tiff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "bytes", "sha256"],
      "properties": {
        "kind": {
          "const": "development-tiff"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483648
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        }
      }
    },
    "Synthetic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "generator", "pattern", "seed"],
      "properties": {
        "kind": {
          "const": "synthetic-rgb"
        },
        "generator": {
          "const": "linear-rgb-f32-v1"
        },
        "pattern": {
          "enum": [
            "dark",
            "bright",
            "red",
            "green",
            "blue",
            "gradient",
            "noise"
          ]
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "Reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_pixels_sha256",
        "film_pixels_sha256",
        "jpeg_sha256",
        "jpeg_bytes",
        "evidence_sha256"
      ],
      "properties": {
        "input_pixels_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "film_pixels_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "jpeg_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "jpeg_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 536870912
        },
        "evidence_sha256": {
          "$ref": "#/$defs/Sha256"
        }
      }
    },
    "Fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "width", "height", "source", "reference"],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9568
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9568
        },
        "source": {
          "oneOf": [
            {
              "$ref": "#/$defs/Tiff"
            },
            {
              "$ref": "#/$defs/Synthetic"
            }
          ]
        },
        "reference": {
          "$ref": "#/$defs/Reference"
        }
      }
    },
    "Catalogue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "numerical_bundle",
        "recipe",
        "procedure",
        "reference_image",
        "input_icc_sha256",
        "output_icc_sha256",
        "fixtures"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "numerical_bundle": {
          "$ref": "#/$defs/Sha256"
        },
        "recipe": {
          "$ref": "#/$defs/Sha256"
        },
        "procedure": {
          "const": "film-once-empty-cache-v1"
        },
        "reference_image": {
          "$ref": "#/$defs/Image"
        },
        "input_icc_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "output_icc_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "fixtures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Fixture"
          },
          "minItems": 1,
          "maxItems": 16
        }
      }
    },
    "Stage": {
      "enum": [
        "staging",
        "decode",
        "initialization",
        "preprocess",
        "exposure",
        "development",
        "printing",
        "scan",
        "gamut",
        "cctf",
        "jpeg",
        "validation"
      ]
    },
    "Term": {
      "enum": [
        "owned-arrays",
        "runtime",
        "native",
        "allocator-retention",
        "kernel"
      ]
    },
    "Bound": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": {
              "const": "unknown"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "bytes", "evidence_sha256"],
          "properties": {
            "status": {
              "const": "qualified"
            },
            "bytes": {
              "$ref": "#/$defs/U64"
            },
            "evidence_sha256": {
              "$ref": "#/$defs/Sha256"
            }
          }
        }
      ]
    },
    "StageBounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "runtime",
        "native",
        "allocator_retention",
        "kernel"
      ],
      "properties": {
        "stage": {
          "$ref": "#/$defs/Stage"
        },
        "runtime": {
          "$ref": "#/$defs/Bound"
        },
        "native": {
          "$ref": "#/$defs/Bound"
        },
        "allocator_retention": {
          "$ref": "#/$defs/Bound"
        },
        "kernel": {
          "$ref": "#/$defs/Bound"
        }
      }
    },
    "ModelCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_id", "stages"],
      "properties": {
        "fixture_id": {
          "$ref": "#/$defs/Id"
        },
        "stages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StageBounds"
          },
          "minItems": 12,
          "maxItems": 12
        }
      }
    },
    "ResourceModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "catalogue_sha256",
        "numerical_bundle",
        "formula",
        "cases"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "catalogue_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "numerical_bundle": {
          "$ref": "#/$defs/Sha256"
        },
        "formula": {
          "const": "film-live-storage-v1"
        },
        "cases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ModelCase"
          },
          "minItems": 1,
          "maxItems": 16
        }
      }
    },
    "Reconcile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "instance", "op"],
      "properties": {
        "version": {
          "const": 2
        },
        "instance": {
          "$ref": "#/$defs/Id"
        },
        "op": {
          "const": "reconcile"
        }
      }
    },
    "Workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "fixture_id"],
      "properties": {
        "kind": {
          "const": "film-fixture"
        },
        "fixture_id": {
          "$ref": "#/$defs/Id"
        }
      }
    },
    "Start": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "instance",
        "op",
        "incarnation",
        "sequence",
        "policy",
        "bundle",
        "catalogue",
        "resource_model",
        "workload"
      ],
      "properties": {
        "version": {
          "const": 2
        },
        "instance": {
          "$ref": "#/$defs/Id"
        },
        "op": {
          "const": "start"
        },
        "incarnation": {
          "$ref": "#/$defs/Id"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "policy": {
          "$ref": "#/$defs/Sha256"
        },
        "bundle": {
          "$ref": "#/$defs/Sha256"
        },
        "catalogue": {
          "$ref": "#/$defs/Sha256"
        },
        "resource_model": {
          "$ref": "#/$defs/Sha256"
        },
        "workload": {
          "$ref": "#/$defs/Workload"
        }
      }
    },
    "Inspect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "instance", "op", "incarnation", "sequence"],
      "properties": {
        "version": {
          "const": 2
        },
        "instance": {
          "$ref": "#/$defs/Id"
        },
        "op": {
          "const": "inspect"
        },
        "incarnation": {
          "$ref": "#/$defs/Id"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        }
      }
    },
    "Cancel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "instance", "op", "incarnation", "sequence"],
      "properties": {
        "version": {
          "const": 2
        },
        "instance": {
          "$ref": "#/$defs/Id"
        },
        "op": {
          "const": "cancel"
        },
        "incarnation": {
          "$ref": "#/$defs/Id"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        }
      }
    },
    "Request": {
      "oneOf": [
        {
          "$ref": "#/$defs/Reconcile"
        },
        {
          "$ref": "#/$defs/Start"
        },
        {
          "$ref": "#/$defs/Inspect"
        },
        {
          "$ref": "#/$defs/Cancel"
        }
      ]
    },
    "Limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memory_bytes",
        "swap_bytes",
        "cpu_quota_us",
        "cpu_period_us",
        "tasks",
        "storage_bytes",
        "storage_inodes"
      ],
      "properties": {
        "memory_bytes": {
          "enum": [
            8589934592, 12884901888, 17179869184, 25769803776, 34359738368
          ]
        },
        "swap_bytes": {
          "const": 0
        },
        "cpu_quota_us": {
          "const": 400000
        },
        "cpu_period_us": {
          "const": 100000
        },
        "tasks": {
          "const": 256
        },
        "storage_bytes": {
          "const": 4294967296
        },
        "storage_inodes": {
          "const": 4096
        }
      }
    },
    "Runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["launch_id", "container_id", "attempt_unit"],
      "properties": {
        "launch_id": {
          "$ref": "#/$defs/Id"
        },
        "container_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Sha256"
            }
          ]
        },
        "attempt_unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9_.-]+\\.slice$",
          "not": {
            "pattern": "[\\r\\n]"
          }
        }
      }
    },
    "Events": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "oom",
        "oom_kill",
        "oom_group_kill",
        "local_oom",
        "local_oom_kill",
        "local_oom_group_kill"
      ],
      "properties": {
        "oom": {
          "$ref": "#/$defs/U64"
        },
        "oom_kill": {
          "$ref": "#/$defs/U64"
        },
        "oom_group_kill": {
          "$ref": "#/$defs/U64"
        },
        "local_oom": {
          "$ref": "#/$defs/U64"
        },
        "local_oom_kill": {
          "$ref": "#/$defs/U64"
        },
        "local_oom_group_kill": {
          "$ref": "#/$defs/U64"
        }
      }
    },
    "TerminalSnapshot": {
      "type": "object",
      "description": "Terminal evidence follows processing-executor-protocol.md. Native validation enforces the shared 4096-byte aggregate bound across the six memory fields and optional io_stat_raw.",
      "additionalProperties": false,
      "required": [
        "cgroup_path",
        "cgroup_inode",
        "unit_invocation",
        "launch_id",
        "container_id",
        "attempt_unit",
        "incarnation",
        "sequence",
        "memory_peak_raw",
        "memory_max_raw",
        "memory_swap_current_raw",
        "memory_swap_max_raw",
        "memory_events_raw",
        "memory_events_local_raw"
      ],
      "properties": {
        "cgroup_path": { "$ref": "#/$defs/AbsolutePath" },
        "cgroup_inode": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "unit_invocation": { "$ref": "#/$defs/Id" },
        "launch_id": { "$ref": "#/$defs/Id" },
        "container_id": { "$ref": "#/$defs/Sha256" },
        "attempt_unit": { "$ref": "#/$defs/Runtime/properties/attempt_unit" },
        "incarnation": { "$ref": "#/$defs/Id" },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "memory_peak_raw": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "memory_max_raw": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "memory_swap_current_raw": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "memory_swap_max_raw": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "memory_events_raw": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "memory_events_local_raw": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "io_stat_raw": {
          "description": "Optional for older persisted snapshots; absent means null. Retained text is exact printable ASCII plus LF from the attempt cgroup's io.stat.",
          "anyOf": [
            { "type": "null" },
            {
              "type": "string",
              "maxLength": 4096,
              "pattern": "^[\\u0020-\\u007e\\n]*$"
            }
          ]
        }
      }
    },
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "peak_bytes",
        "exit_code",
        "docker_oom_killed",
        "attempt_before",
        "attempt_after",
        "parent_before",
        "parent_after",
        "populated",
        "terminal_snapshot"
      ],
      "properties": {
        "peak_bytes": {
          "$ref": "#/$defs/U64"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          ]
        },
        "docker_oom_killed": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "attempt_before": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Events"
            }
          ]
        },
        "attempt_after": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Events"
            }
          ]
        },
        "parent_before": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Events"
            }
          ]
        },
        "parent_after": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Events"
            }
          ]
        },
        "populated": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "terminal_snapshot": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/TerminalSnapshot" }]
        }
      }
    },
    "MissingTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "term"],
      "properties": {
        "stage": {
          "$ref": "#/$defs/Stage"
        },
        "term": {
          "$ref": "#/$defs/Term"
        }
      }
    },
    "Prediction": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "known_required_bytes",
            "known_terms_exceed_limit",
            "missing"
          ],
          "properties": {
            "status": {
              "const": "unqualified"
            },
            "known_required_bytes": {
              "$ref": "#/$defs/U64"
            },
            "known_terms_exceed_limit": {
              "type": "boolean"
            },
            "missing": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/MissingTerm"
              },
              "minItems": 1,
              "maxItems": 60
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "required_bytes"],
          "properties": {
            "status": {
              "const": "fits-model"
            },
            "required_bytes": {
              "$ref": "#/$defs/U64"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "required_bytes"],
          "properties": {
            "status": {
              "const": "exceeds-model"
            },
            "required_bytes": {
              "$ref": "#/$defs/U64"
            }
          }
        }
      ]
    },
    "LocalPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "allowance_bytes",
        "scratch_bytes",
        "batch_pixels",
        "destination_bytes"
      ],
      "properties": {
        "model": {
          "enum": [
            "cam16ucs-srgb-f64-v1",
            "srgb-cctf-f64-v1",
            "jpeg-uint8-rows-v1"
          ]
        },
        "allowance_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "scratch_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "batch_pixels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "destination_bytes": {
          "$ref": "#/$defs/U64"
        }
      }
    },
    "GamutPlan": {
      "allOf": [
        {
          "$ref": "#/$defs/LocalPlan"
        },
        {
          "properties": {
            "model": {
              "const": "cam16ucs-srgb-f64-v1"
            }
          }
        }
      ]
    },
    "CctfPlan": {
      "allOf": [
        {
          "$ref": "#/$defs/LocalPlan"
        },
        {
          "properties": {
            "model": {
              "const": "srgb-cctf-f64-v1"
            }
          }
        }
      ]
    },
    "JpegPlan": {
      "allOf": [
        {
          "$ref": "#/$defs/LocalPlan"
        },
        {
          "properties": {
            "model": {
              "const": "jpeg-uint8-rows-v1"
            }
          }
        }
      ]
    },
    "Plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formula",
        "width",
        "height",
        "source_cache_bytes",
        "storage_reserve_bytes",
        "prediction",
        "gamut",
        "cctf",
        "jpeg"
      ],
      "properties": {
        "formula": {
          "const": "film-live-storage-v1"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "source_cache_bytes": {
          "$ref": "#/$defs/U64"
        },
        "storage_reserve_bytes": {
          "const": 4294967296
        },
        "prediction": {
          "$ref": "#/$defs/Prediction"
        },
        "gamut": {
          "$ref": "#/$defs/GamutPlan"
        },
        "cctf": {
          "$ref": "#/$defs/CctfPlan"
        },
        "jpeg": {
          "$ref": "#/$defs/JpegPlan"
        }
      }
    },
    "Phase": {
      "enum": [
        "preparing",
        "staging",
        "sealed",
        "engine",
        "validating",
        "execution-finished"
      ]
    },
    "Artifact": {
      "type": "object",
