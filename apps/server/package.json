{
  "name": "@slipstream/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "install": "node-gyp rebuild",
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/library && cp src/library/photo-library-worker.cjs src/library/file-kinds.cjs dist/library/",
    "build:native": "node-gyp rebuild",
    "build:native:test": "node-gyp rebuild -- -Dslipstream_build_test_addon=1",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "node-addon-api": "8.5.0",
    "node-gyp": "11.4.2"
  },
  "dependencies": {
    "sharp": "0.34.4"
  }
}
