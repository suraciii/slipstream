{
  "photoStateBatch": [
    {
      "name": "complete",
      "request": {
        "method": "POST",
        "path": "/api/photos/state",
        "body": {
          "selectionState": "picked",
          "photos": [
            {
              "photoId": "$photoId",
              "expectedCurrent": "unflagged"
            },
            {
              "photoId": "$secondPhotoId",
              "expectedCurrent": "rejected"
            }
          ]
        }
      },
      "response": {
        "applied": [
          {
            "photoId": "$photoId",
            "priorValue": "unflagged"
          },
          {
            "photoId": "$secondPhotoId",
            "priorValue": "rejected"
          }
        ],
        "changedElsewhere": [],
        "missing": []
      }
    },
    {
      "name": "partial-changed-elsewhere-and-missing",
      "request": {
        "method": "POST",
        "path": "/api/photos/state",
        "body": {
          "selectionState": "rejected",
          "photos": [
            {
              "photoId": "$photoId",
              "expectedCurrent": "unflagged"
            },
            {
              "photoId": "$secondPhotoId",
              "expectedCurrent": "unflagged"
            },
            {
              "photoId": "$missingPhotoId",
              "expectedCurrent": "picked"
            }
          ]
        }
      },
      "response": {
        "applied": [
          {
            "photoId": "$photoId",
            "priorValue": "unflagged"
          }
        ],
        "changedElsewhere": [
          {
            "photoId": "$secondPhotoId",
            "currentValue": "rejected"
          }
        ],
        "missing": [
          {
            "photoId": "$missingPhotoId"
          }
        ]
      }
    }
  ],
  "albumMembership": [
    {
      "name": "add-result",
      "request": {
        "method": "POST",
        "path": "/api/albums/$albumId/members",
        "body": {
          "photoIds": ["$photoId", "$secondPhotoId"]
        }
      },
      "response": {
        "albumId": "$albumId",
        "addedPhotoIds": ["$photoId"],
        "alreadyMemberPhotoIds": ["$secondPhotoId"],
        "albums": [
          {
            "id": "$albumId",
            "name": "Review",
            "photoCount": 2,
            "hasSavedPosition": false
          }
        ]
      }
    },
    {
      "name": "remove-added-result",
      "request": {
        "method": "POST",
        "path": "/api/albums/$albumId/members/batch-remove",
        "body": {
          "photoIds": ["$photoId", "$secondPhotoId"]
        }
      },
      "response": {
        "albumId": "$albumId",
        "removedPhotoIds": ["$photoId"],
        "alreadyAbsentPhotoIds": ["$secondPhotoId"],
        "albums": [
          {
            "id": "$albumId",
            "name": "Review",
            "photoCount": 1,
            "hasSavedPosition": false
          }
        ]
      }
    }
  ],
