[
  {
    "name": "retired-photo-list",
    "request": {
      "method": "GET",
      "path": "/api/photos"
    },
    "expected": {
      "status": 404,
      "body": {
        "error": "Not found"
      }
    }
  },
  {
    "name": "retired-album-membership-list",
    "request": {
      "method": "GET",
      "path": "/api/albums"
    },
    "expected": {
      "status": 404,
      "body": {
        "error": "Not found"
      }
    }
  },
  {
    "name": "retired-photo-set-create",
    "request": {
      "method": "POST",
      "path": "/api/photo-sets"
    },
    "expected": {
      "status": 404,
      "body": {
        "error": "Not found"
      }
    }
  },
  {
    "name": "unsupported-method-on-retired-photo-list",
    "request": {
      "method": "DELETE",
      "path": "/api/photos"
    },
    "expected": {
      "status": 405,
      "body": {
        "error": "Method not allowed"
      }
    }
  },
  {
    "name": "scan-reports-status-without-photo-facts",
    "request": {
      "method": "POST",
      "path": "/api/scan"
    },
    "expected": {
      "status": 200,
      "body": {
        "state": "idle",
        "publication": "$publication",
        "completed": 0,
        "total": 0
      }
    }
  },
  {
    "name": "album-create-returns-bounded-summaries",
    "request": {
      "method": "POST",
      "path": "/api/albums",
      "headers": {
        "content-type": "application/json"
      },
      "body": {
        "name": "Compat Set"
      }
    },
    "expected": {
      "status": 200,
      "body": {
        "albums": [
          {
            "id": "$setId",
            "name": "Compat Set",
            "photoCount": 0,
            "hasSavedPosition": false
          }
        ]
      }
    }
  },
  {
    "name": "invalid-album",
    "request": {
      "method": "POST",
      "path": "/api/albums",
      "headers": {
        "content-type": "application/json"
      },
      "body": {
        "name": ""
      }
    },
    "expected": {
      "status": 400,
      "body": {
        "error": "Invalid Album name"
      }
    }
  },
  {
    "name": "cross-origin-mutation",
    "request": {
      "method": "POST",
      "path": "/api/scan",
      "headers": {
        "origin": "https://foreign.example"
      }
    },
    "expected": {
      "status": 403,
      "body": {
        "error": "Cross-origin mutation rejected"
      }
    }
  },
  {
    "name": "api-no-spa-fallback",
    "request": {
      "method": "GET",
      "path": "/api/unknown"
    },
    "expected": {
      "status": 404,
      "body": {
        "error": "Not found"
      }
    }
  },
  {
    "name": "index-revalidation",
    "request": {
      "method": "GET",
      "path": "/"
    },
    "expected": {
      "status": 200,
      "headers": {
        "cache-control": "no-cache",
        "content-type": "text/html; charset=utf-8",
        "x-content-type-options": "nosniff"
      },
      "bodyText": "<main>compatibility web</main>"
    }
  },
  {
    "name": "spa-fallback-revalidation",
    "request": {
      "method": "GET",
      "path": "/review/session"
    },
    "expected": {
      "status": 200,
      "headers": {
        "cache-control": "no-cache"
      },
      "bodyText": "<main>compatibility web</main>"
    }
  }
]
