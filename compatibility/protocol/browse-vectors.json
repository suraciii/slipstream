          "00000000-0000-4000-8000-000000000000"
        ],
        "selectionState": "selected"
      }
    },
    "expected": {
      "status": 200,
      "body": {
        "applied": [],
        "conflicts": [
          {
            "photoId": "22aabb24fc11ac401ef1989dd4f0579579b4928169040cde3546d89c4cea7255"
          },
          {
            "photoId": "00000000-0000-4000-8000-000000000000"
