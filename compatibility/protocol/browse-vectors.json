[
  {
    "name": "overview-populated-library",
    "request": {
      "method": "GET",
      "path": "/api/overview"
    },
    "expected": {
      "status": 200,
      "body": {
        "published": true,
        "publication": "$publication",
        "photoCount": 2,
        "scan": {
          "state": "idle",
          "publication": "$publication",
          "completed": 2,
          "total": 2
        },
        "albums": [
          {
            "id": "$albumId",
            "name": "Compat Album",
            "photoCount": 2,
            "hasSavedPosition": false
          }
        ]
      }
    }
  },
  {
    "name": "browse-open-library",
    "request": {
      "method": "POST",
      "path": "/api/browse",
      "headers": {
        "content-type": "application/json",
        "origin": "http://camera.local"
      },
      "body": {
        "source": "library"
      }
    },
    "expected": {
      "status": 200,
      "body": {
        "token": "$token",
        "total": 2,
        "position": 0,
        "selectionCounts": {
          "selected": 0,
          "rejected": 0,
          "undecided": 2
        }
      }
    }
  },
  {
    "name": "browse-window-library-populated",
    "request": {
      "method": "GET",
      "path": "/api/browse/$token?start=0&limit=60"
    },
    "expected": {
      "status": 200,
      "body": {
        "start": 0,
        "total": 2,
        "photos": [
          {
            "id": "$photoId",
            "available": true,
            "ambiguous": false,
            "originalFilename": "pair.ARW",
            "originals": [
              {
                "kind": "raw",
                "available": true
              },
              {
                "kind": "jpeg",
                "available": true
              }
            ],
            "selectionState": "undecided",
            "rating": 0,
            "preview": {
              "state": "ready",
              "source": "matching-jpeg",
              "width": 90,
              "height": 45,
              "limitedDetail": true,
              "url": "$reviewUrl",
              "thumbnailUrl": "$thumbnailUrl"
            }
          },
          {
            "id": "$secondPhotoId",
            "available": true,
            "ambiguous": false,
            "originalFilename": "later.JPG",
            "originals": [
              {
                "kind": "jpeg",
                "available": true
              }
            ],
            "selectionState": "undecided",
            "rating": 0,
            "preview": {
              "state": "ready",
              "source": "matching-jpeg",
              "width": 120,
              "height": 60,
              "limitedDetail": true,
              "url": "$secondReviewUrl",
              "thumbnailUrl": "$secondThumbnailUrl"
            }
          }
        ]
      }
    }
  },
