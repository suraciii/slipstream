#!/usr/bin/env bash

set -euo pipefail

readonly storage_roles=(library state cache)
declare -A storage_keys=(
  [library]=SLIPSTREAM_LIBRARY_ROOT
  [state]=SLIPSTREAM_STATE_DIRECTORY
  [cache]=SLIPSTREAM_CACHE_DIRECTORY
)
declare -A storage_sources=()
declare -A storage_filesystems=()
declare -A storage_effective_paths=()

fail() {
  printf 'slipstream compose: %s\n' "$*" >&2
  exit 2
}

require_local_docker() {
  if [[ "$(uname -s)" != Linux ]]; then
    fail "local Docker Engine requires Linux"
  fi
  if [[ -v DOCKER_HOST || -v DOCKER_CONTEXT ]]; then
    fail "local Docker Engine does not allow DOCKER_HOST or DOCKER_CONTEXT"
  fi
  local captured endpoint
  if ! captured=$(
    docker context inspect default --format '{{ .Endpoints.docker.Host }}' 2>/dev/null || exit 1
    printf '\037'
  ); then
    fail "local Docker Engine default context is unavailable"
  fi
  [[ "$captured" == *$'\037' ]] || fail "local Docker Engine default context is malformed"
  captured=${captured%$'\037'}
  [[ "$captured" == *$'\n' ]] || fail "local Docker Engine default context is malformed"
  endpoint=${captured%$'\n'}
  if [[ ! "$endpoint" =~ ^unix:///[^[:cntrl:]]+$ ]]; then
    fail "local Docker Engine default context must use a Unix socket"
  fi
}

resolved_path=''

resolve_existing_path() {
  local input=$1 captured
  if ! captured=$(
    realpath -e -- "$input" || exit 1
    printf '\037'
  ); then
    return 1
  fi
  [[ "$captured" == *$'\037' ]] || return 1
  captured=${captured%$'\037'}
  [[ "$captured" == *$'\n' ]] || return 1
  resolved_path=${captured%$'\n'}
}

literal_storage_path() {
  local value=$1
  [[ "$value" == /* ]] || return 1
  [[ "$value" != [[:space:]]* && "$value" != *[[:space:]] ]] || return 1
  [[ "$value" != *[[:cntrl:]]* ]] || return 1
  [[ "$value" != *'#'* && "$value" != *"'"* && "$value" != *'"'* ]] || return 1
  [[ "$value" != *'\'* && "$value" != *'`'* && "$value" != *'$'* ]] || return 1
}

parse_storage_sources() {
  local environment_file=$1
  local line key value role canonical
  declare -A declared=()
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ "$line" =~ ^[[:space:]]*$ || "$line" =~ ^[[:space:]]*# ]] && continue
    for role in "${storage_roles[@]}"; do
      key=${storage_keys[$role]}
      if [[ "$line" == "$key="* ]]; then
        [[ ! -v "declared[$key]" ]] || fail "storage environment file has duplicate $key"
        value=${line#"$key="}
        literal_storage_path "$value" || fail "storage environment file has invalid $key"
        resolve_existing_path "$value" || fail "storage environment file has unavailable $key"
        canonical=$resolved_path
        literal_storage_path "$canonical" || fail "storage environment file has invalid $key"
        [[ -d "$canonical" ]] || fail "storage environment file has non-directory $key"
        declared[$key]=1
        storage_sources[$role]=$canonical
        continue 2
      fi
      if [[ "$line" =~ ^[[:space:]]*(export[[:space:]]+)?${key}([^A-Za-z0-9_]|$) ]]; then
        fail "storage environment file has invalid $key"
      fi
    done
  done < "$environment_file"
  for role in "${storage_roles[@]}"; do
    key=${storage_keys[$role]}
    [[ -v "declared[$key]" ]] || fail "storage environment file is missing $key"
  done
}

reject_engine_control_declarations() {
  local environment_file=$1
  local line
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ "$line" =~ ^[[:space:]]*$ || "$line" =~ ^[[:space:]]*# ]] && continue
    if [[ "$line" =~ ^[[:space:]]*(export[[:space:]]+)?(COMPOSE|DOCKER)_[A-Za-z0-9_]*[[:space:]]*(=|$) ]]; then
      fail "environment file must not declare Compose or Docker control variables"
    fi
  done < "$environment_file"
}

contains_path() {
  local ancestor=$1
  local descendant=$2
  [[ "$ancestor" == / || "$ancestor" == "$descendant" || "$descendant" == "$ancestor/"* ]]
}

canonical_mount_path() {
  local value=$1
  [[ "$value" == /* ]] || return 1
  [[ "$value" != *[[:cntrl:]]* ]] || return 1
  [[ "$value" == / || "$value" != */ ]] || return 1
  [[ "$value" != *'//'* ]] || return 1
  [[ "$value" != */./* && "$value" != */. ]] || return 1
  [[ "$value" != */../* && "$value" != */.. ]] || return 1
}

decoded_findmnt_value=''

decode_findmnt_raw() {
  local encoded=$1 decoded='' prefix remainder hex character
  while [[ "$encoded" == *'\x'* ]]; do
    prefix=${encoded%%'\x'*}
    remainder=${encoded#*'\x'}
    [[ ${#remainder} -ge 2 ]] || return 1
    hex=${remainder:0:2}
    [[ "$hex" =~ ^[0-9A-Fa-f]{2}$ && "$hex" != 00 ]] || return 1
    printf -v character '%b' "\\x$hex"
    decoded+="$prefix$character"
    encoded=${remainder:2}
  done
  [[ "$encoded" != *'\'* ]] || return 1
  decoded_findmnt_value="$decoded$encoded"
}

findmnt_field() {
  local endpoint=$1
  local field=$2
  local captured encoded value
  if ! captured=$(
    LC_ALL=C findmnt --noheadings --raw -T "$endpoint" -o "$field" 2>/dev/null || exit 1
    printf '\037'
  ); then
    return 1
  fi
  [[ "$captured" == *$'\037' ]] || return 1
  encoded=${captured%$'\037'}
  [[ "$encoded" == *$'\n' ]] || return 1
  encoded=${encoded%$'\n'}
  [[ -n "$encoded" && "$encoded" != *$'\n'* && "$encoded" != *[[:cntrl:]]* ]] || return 1
  decode_findmnt_raw "$encoded" || return 1
  value=$decoded_findmnt_value
  [[ -n "$value" && "$value" != *$'\n'* && "$value" != *[[:cntrl:]]* ]] || return 1
  printf '%s\n' "$value"
}

relative_to_mount_target() {
  local endpoint=$1
  local target=$2
  if [[ "$target" == / ]]; then
    printf '%s\n' "$endpoint"
  elif [[ "$endpoint" == "$target" ]]; then
    printf '/\n'
  else
    printf '/%s\n' "${endpoint#"$target/"}"
  fi
}

effective_mount_path() {
  local fsroot=$1
  local relative=$2
  if [[ "$relative" == / ]]; then
    printf '%s\n' "$fsroot"
  elif [[ "$fsroot" == / ]]; then
    printf '%s\n' "$relative"
  else
    printf '%s%s\n' "$fsroot" "$relative"
  fi
}

capture_mount_coordinates() {
  local role endpoint target fsroot filesystem relative effective
  for role in "${storage_roles[@]}"; do
    endpoint=${storage_sources[$role]}
    target=$(findmnt_field "$endpoint" TARGET) \
      || fail "findmnt cannot determine mount TARGET for $role"
    fsroot=$(findmnt_field "$endpoint" FSROOT) \
      || fail "findmnt cannot determine mount FSROOT for $role"
    filesystem=$(findmnt_field "$endpoint" MAJ:MIN) \
      || fail "findmnt cannot determine mount MAJ:MIN for $role"
    literal_storage_path "$target" && canonical_mount_path "$target" \
      || fail "findmnt returned an invalid mount TARGET for $role"
    literal_storage_path "$fsroot" && canonical_mount_path "$fsroot" \
      || fail "findmnt returned an invalid mount FSROOT for $role"
    [[ "$filesystem" =~ ^[0-9]+:[0-9]+$ ]] \
      || fail "findmnt returned an invalid mount MAJ:MIN for $role"
    contains_path "$target" "$endpoint" \
      || fail "findmnt mount TARGET is not an ancestor of $role"
    relative=$(relative_to_mount_target "$endpoint" "$target")
    effective=$(effective_mount_path "$fsroot" "$relative")
    literal_storage_path "$effective" && canonical_mount_path "$effective" \
      || fail "findmnt returned an invalid effective path for $role"
    storage_filesystems[$role]=$filesystem
    storage_effective_paths[$role]=$effective
  done
}

reject_overlaps() {
  local left right index next
  for ((index = 0; index < ${#storage_roles[@]}; index += 1)); do
    left=${storage_roles[$index]}
    for ((next = index + 1; next < ${#storage_roles[@]}; next += 1)); do
      right=${storage_roles[$next]}
      if contains_path "${storage_sources[$left]}" "${storage_sources[$right]}" \
        || contains_path "${storage_sources[$right]}" "${storage_sources[$left]}"; then
        fail "host storage paths overlap: $left and $right"
      fi
    done
  done
}

reject_mount_coordinate_overlaps() {
  local left right index next
  for ((index = 0; index < ${#storage_roles[@]}; index += 1)); do
    left=${storage_roles[$index]}
    for ((next = index + 1; next < ${#storage_roles[@]}; next += 1)); do
      right=${storage_roles[$next]}
      if [[ "${storage_filesystems[$left]}" == "${storage_filesystems[$right]}" ]] \
        && { contains_path "${storage_effective_paths[$left]}" "${storage_effective_paths[$right]}" \
          || contains_path "${storage_effective_paths[$right]}" "${storage_effective_paths[$left]}"; }; then
        fail "host storage paths overlap: $left and $right"
      fi
    done
  done
}

command -v realpath >/dev/null || fail "GNU realpath is required"

if [[ $# -lt 3 || $1 != --env-file ]]; then
  fail "usage: scripts/compose --env-file PATH {up [-d]|run --rm --no-deps slipstream expand-library|down}"
fi

environment_file_input=$2
shift 2
[[ -r "$environment_file_input" && -f "$environment_file_input" ]] \
  || fail "environment file must be a readable regular file"
resolve_existing_path "$environment_file_input" \
  || fail "environment file must be canonicalizable"
environment_file=$resolved_path
[[ -r "$environment_file" && -f "$environment_file" ]] \
  || fail "environment file must be a readable regular file"
reject_engine_control_declarations "$environment_file"

startup=false
if [[ $# -eq 1 && $1 == up ]]; then
  compose_command=(up)
  startup=true
elif [[ $# -eq 2 && $1 == up && $2 == -d ]]; then
  compose_command=(up -d)
  startup=true
elif [[ $# -eq 5 && $1 == run && $2 == --rm && $3 == --no-deps && $4 == slipstream && $5 == expand-library ]]; then
  compose_command=(run --rm --no-deps slipstream expand-library)
  startup=true
elif [[ $# -eq 1 && $1 == down ]]; then
  compose_command=(down)
else
  fail "unsupported Compose command"
fi

resolve_existing_path "${BASH_SOURCE[0]}" \
  || fail "entry point must be canonicalizable"
entry_point=$resolved_path
resolve_existing_path "$(dirname -- "$(dirname -- "$entry_point")")/compose.yaml" \
  || fail "repository compose.yaml is unavailable"
compose_file=$resolved_path

if [[ "$startup" == true ]]; then
  command -v findmnt >/dev/null || fail "Linux findmnt is required"
  parse_storage_sources "$environment_file"
  reject_overlaps
  capture_mount_coordinates
  reject_mount_coordinate_overlaps
fi

require_local_docker
unset COMPOSE_DISABLE_ENV_FILE COMPOSE_ENV_FILES COMPOSE_FILE COMPOSE_PATH_SEPARATOR
unset COMPOSE_PROFILES COMPOSE_PROJECT_NAME
unset SLIPSTREAM_IMAGE SLIPSTREAM_VCS_REF SLIPSTREAM_BIND_ADDRESS
unset SLIPSTREAM_PORT SLIPSTREAM_PUBLIC_ORIGIN SLIPSTREAM_DATABASE_BASENAME
unset SLIPSTREAM_LIBRARY_ROOT SLIPSTREAM_STATE_DIRECTORY SLIPSTREAM_CACHE_DIRECTORY

if [[ "$startup" == true ]]; then
  export SLIPSTREAM_LIBRARY_ROOT="${storage_sources[library]}"
  export SLIPSTREAM_STATE_DIRECTORY="${storage_sources[state]}"
  export SLIPSTREAM_CACHE_DIRECTORY="${storage_sources[cache]}"
fi

exec docker --context default compose --project-name slipstream --env-file "$environment_file" -f "$compose_file" "${compose_command[@]}"
